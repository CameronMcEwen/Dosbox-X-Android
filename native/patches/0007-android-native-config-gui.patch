+#include <sstream>
+#include <vector>
+
+static std::string json_escape(const std::string& s) {
+    std::stringstream ss;
+    for (size_t i = 0; i < s.length(); ++i) {
+        char c = s[i];
+        if (c == '"') ss << "\\\"";
+        else if (c == '\\') ss << "\\\\";
+        else if (c == '\b') ss << "\\b";
+        else if (c == '\f') ss << "\\f";
+        else if (c == '\n') ss << "\\n";
+        else if (c == '\r') ss << "\\r";
+        else if (c == '\t') ss << "\\t";
+        else if ((unsigned char)c < 32) {
+            char buf[8];
+            snprintf(buf, sizeof(buf), "\\u%04x", (int)c);
+            ss << buf;
+        } else ss << c;
+    }
+    return ss.str();
+}
+
+extern "C" JNIEXPORT jobjectArray JNICALL
+Java_com_dosboxx_app_DosConfig_getSections(JNIEnv *env, jclass clazz) {
+    (void)clazz;
+    std::vector<std::string> names;
+    for (int i = 0; ; ++i) {
+        Section* s = control->GetSection(i);
+        if (!s) break;
+        names.push_back(s->GetName());
+    }
+    jclass stringClass = env->FindClass("java/lang/String");
+    jobjectArray array = env->NewObjectArray((jsize)names.size(), stringClass, NULL);
+    for (size_t i = 0; i < names.size(); ++i) {
+        env->SetObjectArrayElement(array, (jsize)i, env->NewStringUTF(names[i].c_str()));
+    }
+    return array;
+}
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_dosboxx_app_DosConfig_getSectionProperties(JNIEnv *env, jclass clazz, jstring sectionName) {
+    (void)clazz;
+    const char* nativeSectionName = env->GetStringUTFChars(sectionName, 0);
+    Section* s = control->GetSection(nativeSectionName);
+    env->ReleaseStringUTFChars(sectionName, nativeSectionName);
+
+    if (!s) return env->NewStringUTF("[]");
+
+    Section_prop* sp = dynamic_cast<Section_prop*>(s);
+    if (!sp) return env->NewStringUTF("[]");
+
+    std::stringstream ss;
+    ss << "[";
+    bool first = true;
+    for (int i = 0; ; ++i) {
+        Property* p = sp->Get_prop(i);
+        if (!p) break;
+
+        if (!first) ss << ",";
+        first = false;
+
+        ss << "{";
+        ss << "\"name\":\"" << json_escape(p->propname) << "\",";
+        ss << "\"type\":" << (int)p->Get_type() << ",";
+        ss << "\"value\":\"" << json_escape(p->GetValue().ToString()) << "\",";
+        ss << "\"default\":\"" << json_escape(p->Get_Default_Value().ToString()) << "\",";
+        ss << "\"help\":\"" << json_escape(p->Get_help() ? p->Get_help() : "") << "\",";
+        ss << "\"values\":[";
+        const std::vector<Value>& vals = p->GetValues();
+        for (size_t j = 0; j < vals.size(); ++j) {
+            if (j > 0) ss << ",";
+            ss << "\"" << json_escape(vals[j].ToString()) << "\"";
+        }
+        ss << "]}";
+    }
+    ss << "]";
+    return env->NewStringUTF(ss.str().c_str());
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_dosboxx_app_DosConfig_setProperty(JNIEnv *env, jclass clazz, jstring sectionName, jstring propName, jstring value) {
+    (void)clazz;
+    const char* ns = env->GetStringUTFChars(sectionName, 0);
+    const char* np = env->GetStringUTFChars(propName, 0);
+    const char* nv = env->GetStringUTFChars(value, 0);
+
+    Section* s = control->GetSection(ns);
+    bool ok = false;
+    if (s) {
+        Section_prop* sp = dynamic_cast<Section_prop*>(s);
+        if (sp) {
+            Property* p = sp->Get_prop(np);
+            if (p) {
+                ok = p->SetValue(nv);
+                if (ok) {
+                    for (std::list<SectionFunction>::iterator i = sp->onpropchange.begin(); i != sp->onpropchange.end(); ++i) {
+                        (*i)(sp);
+                    }
+                }
+            }
+        }
+    }
+
+    env->ReleaseStringUTFChars(sectionName, ns);
+    env->ReleaseStringUTFChars(propName, np);
+    env->ReleaseStringUTFChars(value, nv);
+    return ok;
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_dosboxx_app_DosConfig_saveConfig(JNIEnv *env, jclass clazz) {
+    (void)clazz;
+    if (control->configfiles.empty()) return false;
+    return control->PrintConfig(control->configfiles[0].c_str());
+}
